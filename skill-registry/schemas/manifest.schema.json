{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "version", "category", "description", "triggers", "risk_level", "requires", "outputs", "governance"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "version": {"type": "string"},
    "category": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "triggers": {"type": "array", "items": {"type": "string"}},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "requires": {"type": "object", "properties": {"actions": {"type": "array", "items": {"type": "string"}}, "plugins": {"type": "array", "items": {"type": "string"}}}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "governance": {"type": "object", "properties": {"confirmation": {"type": "boolean"}}}
  }
}
